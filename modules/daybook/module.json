      "widgets": [
        { "id": "recent-memory", "label": "Letzte Erinnerung" }
      ]
    },
    "widgets": [
      {
        "id": "recent-memory",
        "entry": "widgets/recent-memory.js",
        "label": "Letzte Erinnerung",
        "labelKey": "widgets.recent-memory",
        "icon": "images",
        "defaultSize": "1x2",
        "defaultVisible": true
      }
    ],
    "api": { "prefix": "/api/extensions/daybook" }
