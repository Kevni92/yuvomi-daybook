{
  "manifestVersion": 1,
  "id": "daybook",
  "name": "Familientagebuch",
  "version": "0.1.0",
  "description": "Private Familienchronik mit Text, Fotos, Audio und Orten.",
  "entry": "index.js",
  "style": "style.css",
  "icon": "book-heart",
  "accent": "#D88AA2",
  "menu": {
    "show": true,
    "label": "Familientagebuch",
    "labelKey": "menu",
    "icon": "book-heart",
